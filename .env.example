# Copy this file to .env for local testing with `vercel dev`, and add the
# same values in the Vercel dashboard: Project Settings -> Environment
# Variables. Never commit the real .env file.

# SMTP server that will send the contact form email.
# Works with any standard SMTP provider (Gmail app password, Zoho, Outlook,
# SendGrid, Mailgun, your host's mail server, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Mailbox that receives contact form submissions
CONTACT_TO_EMAIL=info@summitridge.example
# Optional: "From" address shown on the outgoing email. Defaults to SMTP_USER
# if not set. Some providers require this to match the authenticated user.
CONTACT_FROM_EMAIL=info@summitridge.example
